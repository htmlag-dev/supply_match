# Пример переменных окружения. Файл автоматически не загружается.
# Никогда не записывайте настоящие ключи в Git или мобильную сборку.
SUPPLY_MATCH_OPENROUTER_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_AI_API_KEY=
TAVILY_API_KEY=

# Для приватного удалённого пространства за HTTPS reverse proxy
SUPPLY_MATCH_PUBLIC_HOST=
SUPPLY_MATCH_TOKEN=
SUPPLY_MATCH_ALLOWED_ORIGINS=capacitor://localhost,https://localhost

# Подписка приложения, RUB
SUPPLY_MATCH_BILLING_SHOP_ID=
SUPPLY_MATCH_BILLING_SECRET=
SUPPLY_MATCH_PAYMENT_RETURN_URL=
# Пример отдельного подключённого продавца с id=7
SUPPLY_MATCH_SELLER_7_SHOP_ID=
SUPPLY_MATCH_SELLER_7_SECRET=

# Только URL API для native-сборки; не секрет
SUPPLY_MATCH_MOBILE_API_URL=
# Accounts, encryption and public deployment
SUPPLY_MATCH_ENV=development
# In production: HTTPS public URL, public hostname, 32-byte random key encoded in URL-safe base64.
SUPPLY_MATCH_PUBLIC_URL=
SUPPLY_MATCH_PUBLIC_HOST=
SUPPLY_MATCH_ENCRYPTION_KEY=
# OAuth credentials belong on the SERVER only. Apple CLIENT_SECRET is an ES256 signed JWT.
SUPPLY_MATCH_GOOGLE_CLIENT_ID=
SUPPLY_MATCH_GOOGLE_CLIENT_SECRET=
SUPPLY_MATCH_APPLE_CLIENT_ID=
SUPPLY_MATCH_APPLE_CLIENT_SECRET=
SUPPLY_MATCH_APPLE_TEAM_ID=
SUPPLY_MATCH_APPLE_KEY_ID=
SUPPLY_MATCH_APPLE_PRIVATE_KEY_FILE=
# Email verification (no local bypass)
SUPPLY_MATCH_SMTP_HOST=
SUPPLY_MATCH_SMTP_PORT=465
SUPPLY_MATCH_SMTP_SECURITY=ssl
SUPPLY_MATCH_SMTP_FROM=
SUPPLY_MATCH_SMTP_USER=
SUPPLY_MATCH_SMTP_PASSWORD=
# Trust X-Real-IP only from the local reverse proxy which overwrites the header.
SUPPLY_MATCH_TRUST_PROXY=0

# Optional PostgreSQL backend. Install requirements-server.txt first.
# Migrate offline with scripts/migrate_postgres.py before switching existing data.
# Use sslmode=verify-full and a trusted CA for remote servers. Leave empty for encrypted SQLite.
SUPPLY_MATCH_DATABASE_URL=
